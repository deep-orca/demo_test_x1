FROM python:3.12-slim

WORKDIR /app

ARG user_id=1000
ARG group_id=1000
ARG python_version=3.13

RUN <<EOF
[ $user_id -gt 0 ] && user="$(id --name --user $user_id 2> /dev/null)" && userdel "$user"

if [ $group_id -gt 0 ]; then
  group="$(id --name --group $group_id 2> /dev/null)" && groupdel "$group"
  groupadd --gid $group_id app
fi

[ $user_id -gt 0 ] && useradd --uid $user_id --gid $group_id --home-dir /app app
EOF

# Отключаем буферизацию вывода, чтобы логи сразу появлялись в консоли Docker
ENV PYTHONUNBUFFERED=1

COPY  --chown=$user_id:$group_id requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# COPY  --chown=$user_id:$group_id . /app
COPY  . /app
COPY  ./src/ /app/src
#COPY  --chown=$user_id:$group_id ./alembic/ /app/alembic

# USER $user_id:$group_id
